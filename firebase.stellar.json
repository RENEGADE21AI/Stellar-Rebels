{
  "hosting": {
    "target": "stellar",
    "public": "dist-stellar",
    "ignore": ["**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" }
        ]
      },
      { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
      { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
      { "source": "/version.json", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
      { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }] },
      { "source": "/arcade/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
    ]
  }
}
